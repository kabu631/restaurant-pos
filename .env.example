# ─────────────────────────────────────────────────────────────────────────────
# Restaurant POS – Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ───────────────────────────────────────────────────────────────────
# Option A — XAMPP (MySQL/MariaDB): start MySQL in the XAMPP Control Panel, then in
# phpMyAdmin create a database "restaurant_pos" with collation utf8mb4_unicode_ci.
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/restaurant_pos?charset=utf8mb4
#
# Option B — PostgreSQL: create the database in pgAdmin (Databases → Create → restaurant_pos)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaurant_pos

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production

# ── Server ────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ── FonePay (get from https://fonepay.com merchant portal) ───────────────────
FONEPAY_MERCHANT_CODE=DEMO_PID
FONEPAY_MERCHANT_PASSWORD=DEMO_MD
FONEPAY_SECRET_KEY=DEMO_SECRET
FONEPAY_BASE_URL=https://dev-clientapi.fonepay.com/api/
# Public URL FonePay posts the payment callback to (use ngrok for local dev)
FONEPAY_CALLBACK_BASE=http://127.0.0.1:8000

# ── Thermal Printer (leave blank to disable direct printing) ──────────────────
# Windows COM port example: COM3
# Linux USB example: /dev/usb/lp0
THERMAL_PRINTER_PATH=

# ── Cloud Sync (optional – leave blank to disable) ───────────────────────────
CLOUD_SYNC_URL=

# ── Backup ────────────────────────────────────────────────────────────────────
# Number of daily backup files to keep (older ones are auto-deleted)
BACKUP_KEEP_DAYS=30
